<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/mini_card_bg"
    android:padding="6dp"
    android:layout_marginBottom="3dp"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/svc_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textSize="11sp"
        android:maxLines="1"
        android:ellipsize="end"/>

    <TextView
        android:id="@+id/svcType"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="10sp"
        android:textColor="?android:attr/textColorSecondary"
        android:layout_marginEnd="6dp"/>

    <TextView
        android:id="@+id/svcDur"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="5dp"
        android:paddingVertical="1dp"
        android:textSize="10sp"
        android:textColor="#0C447C"
        android:background="@drawable/badge_bg_blue"
        android:layout_marginEnd="4dp"/>

    <TextView
        android:id="@+id/svcWatt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="5dp"
        android:paddingVertical="1dp"
        android:textSize="10sp"
        android:textColor="#3C3489"
        android:background="@drawable/badge_bg_purple"/>

</LinearLayout>
