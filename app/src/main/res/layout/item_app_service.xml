<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header row -->
        <LinearLayout
            android:id="@+id/app_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="10dp"
            android:gravity="center_vertical"
            android:background="?attr/selectableItemBackground">

            <View android:id="@+id/risk_dot"
                android:layout_width="10dp" android:layout_height="10dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/circle_dot"/>

            <ImageView android:id="@+id/app_icon"
                android:layout_width="36dp" android:layout_height="36dp"
                android:layout_marginEnd="8dp"/>

            <LinearLayout
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">

                <TextView android:id="@+id/app_name"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textSize="13sp" android:textStyle="bold"
                    android:maxLines="1" android:ellipsize="end"/>

                <TextView android:id="@+id/app_pkg"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textSize="10sp" android:textColor="?android:attr/textColorSecondary"
                    android:maxLines="1" android:ellipsize="end"/>

                <LinearLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="3dp">

                    <TextView android:id="@+id/badge_risk"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:paddingHorizontal="6dp" android:paddingVertical="2dp"
                        android:textSize="9sp" android:layout_marginEnd="3dp"
                        android:background="@drawable/badge_bg"/>
                    <TextView android:id="@+id/badge_watt"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:paddingHorizontal="6dp" android:paddingVertical="2dp"
                        android:textSize="9sp" android:layout_marginEnd="3dp"
                        android:background="@drawable/badge_bg_purple"
                        android:textColor="#3C3489"/>
                    <TextView android:id="@+id/badge_uptime"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:paddingHorizontal="6dp" android:paddingVertical="2dp"
                        android:textSize="9sp"
                        android:background="@drawable/badge_bg_blue"
                        android:textColor="#0C447C"/>
                    <TextView android:id="@+id/badge_ram"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:paddingHorizontal="6dp" android:paddingVertical="2dp"
                        android:textSize="9sp" android:layout_marginStart="3dp"
                        android:background="@drawable/badge_bg_gray"
                        android:textColor="?android:attr/textColorSecondary"/>
                </LinearLayout>
            </LinearLayout>

            <ImageView android:id="@+id/expand_icon"
                android:layout_width="20dp" android:layout_height="20dp"
                android:src="@drawable/ic_chevron_down"
                android:layout_marginStart="4dp"/>
        </LinearLayout>

        <!-- Energy bar -->
        <ProgressBar
            android:id="@+id/energy_bar"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:max="100"
            android:progress="0"/>

        <!-- Detail panel -->
        <LinearLayout
            android:id="@+id/detail_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp"
            android:background="?attr/colorSurfaceVariant"
            android:visibility="gone">

            <!-- Warn box -->
            <LinearLayout
                android:id="@+id/warn_box"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/warn_box_bg"
                android:padding="8dp" android:layout_marginBottom="8dp"
                android:visibility="gone">
                <TextView android:id="@+id/warn_text"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textSize="11sp" android:textColor="#854F0B"/>
            </LinearLayout>

            <!-- Mini stats -->
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="8dp">
                <LinearLayout
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical"
                    android:background="@drawable/mini_card_bg"
                    android:padding="6dp" android:layout_marginEnd="4dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Uptime sekarang" android:textSize="9sp"
                        android:textColor="?android:attr/textColorSecondary"/>
                    <TextView android:id="@+id/stat_uptime"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textSize="13sp" android:textStyle="bold" android:textColor="#0C447C"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical"
                    android:background="@drawable/mini_card_bg"
                    android:padding="6dp" android:layout_marginEnd="4dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Total waktu" android:textSize="9sp"
                        android:textColor="?android:attr/textColorSecondary"/>
                    <TextView android:id="@+id/stat_total_time"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textSize="13sp" android:textStyle="bold" android:textColor="#534AB7"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical"
                    android:background="@drawable/mini_card_bg"
                    android:padding="6dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Estimasi daya" android:textSize="9sp"
                        android:textColor="?android:attr/textColorSecondary"/>
                    <TextView android:id="@+id/stat_watt_detail"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textSize="13sp" android:textStyle="bold" android:textColor="#A32D2D"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Service list (dynamic) -->
            <TextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Service aktif" android:textSize="10sp"
                android:textColor="?android:attr/textColorSecondary"
                android:textAllCaps="true" android:letterSpacing="0.05"
                android:layout_marginBottom="4dp"/>

            <LinearLayout
                android:id="@+id/service_list"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:layout_marginBottom="8dp"/>

            <!-- Action buttons -->
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_stop_temp"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Hentikan sementara"
                    android:textSize="10sp"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_marginEnd="4dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_force_stop"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Paksa berhenti"
                    android:textSize="10sp"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_marginEnd="4dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_disable"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Nonaktifkan"
                    android:textSize="10sp"
                    style="@style/Widget.Material3.Button.OutlinedButton"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
