<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Mode Banner -->
    <TextView
        android:id="@+id/mode_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:textAlignment="center"
        android:textColor="@android:color/white"
        android:textSize="12sp" />

    <!-- Stats row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp">

        <TextView android:id="@+id/stat_total"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:textAlignment="center" android:textSize="12sp"/>
        <TextView android:id="@+id/stat_watt"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:textAlignment="center" android:textSize="12sp"/>
        <TextView android:id="@+id/stat_red"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:textAlignment="center" android:textSize="12sp"
            android:textColor="#E24B4A"/>
        <TextView android:id="@+id/stat_yellow"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:textAlignment="center" android:textSize="12sp"
            android:textColor="#EF9F27"/>
    </LinearLayout>

    <!-- Sort chips -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">
        <com.google.android.material.chip.ChipGroup
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="8dp"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_watt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Paling boros"
                style="@style/Widget.Material3.Chip.Filter"/>
            <com.google.android.material.chip.Chip
                android:id="@+id/chip_az"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="A–Z"
                style="@style/Widget.Material3.Chip.Filter"/>
            <com.google.android.material.chip.Chip
                android:id="@+id/chip_za"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Z–A"
                style="@style/Widget.Material3.Chip.Filter"/>
            <com.google.android.material.chip.Chip
                android:id="@+id/chip_uptime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Uptime"
                style="@style/Widget.Material3.Chip.Filter"/>
            <com.google.android.material.chip.Chip
                android:id="@+id/chip_total_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total waktu"
                style="@style/Widget.Material3.Chip.Filter"/>
            <com.google.android.material.chip.Chip
                android:id="@+id/chip_risk"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bahaya"
                style="@style/Widget.Material3.Chip.Filter"/>
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- List -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="8dp"
            android:clipToPadding="false" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Empty state -->
    <TextView
        android:id="@+id/empty_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="32dp"
        android:text="Tidak ada service yang terdeteksi.\nCoba izinkan Usage Stats di pengaturan."
        android:textAlignment="center"
        android:textColor="?android:attr/textColorSecondary"
        android:visibility="gone" />

</LinearLayout>
